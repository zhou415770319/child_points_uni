import type { DeviceInfo, NetworkInfo, BatteryInfo } from '../types/device'

/**
 * 获取设备信息 - Android实现
 */
export function getDeviceInfo(): DeviceInfo {
	const context = android.content.Context
	const packageManager = context.getPackageManager()
	const packageName = context.getPackageName()
	const packageInfo = packageManager.getPackageInfo(packageName, 0)
	
	const build = android.os.Build
	const displayMetrics = context.getResources().getDisplayMetrics()
	
	return {
		model: build.MODEL,
		brand: build.BRAND,
		osVersion: build.VERSION.RELEASE,
		osType: 'android',
		uuid: android.provider.Settings.Secure.getString(
			context.getContentResolver(),
			android.provider.Settings.Secure.ANDROID_ID
		) || 'unknown',
		appVersion: packageInfo.versionName,
		appVersionCode: String(packageInfo.versionCode),
		deviceName: build.MODEL,
		screenWidth: displayMetrics.widthPixels,
		screenHeight: displayMetrics.heightPixels,
		pixelRatio: displayMetrics.density
	}
}

/**
 * 获取网络信息 - Android实现
 */
export function getNetworkInfo(): NetworkInfo {
	const context = android.content.Context
	const connectivityManager = context.getSystemService(
		android.content.Context.CONNECTIVITY_SERVICE
	) as android.net.ConnectivityManager
	
	const network = connectivityManager.getActiveNetwork()
	const capabilities = connectivityManager.getNetworkCapabilities(network)
	
	if (!network || !capabilities) {
		return {
			type: 'none',
			isConnected: false
		}
	}
	
	let type: 'wifi' | '4g' | '3g' | '2g' | 'unknown' = 'unknown'
	
	if (capabilities.hasTransport(android.net.NetworkCapabilities.TRANSPORT_WIFI)) {
		type = 'wifi'
	} else if (capabilities.hasTransport(android.net.NetworkCapabilities.TRANSPORT_CELLULAR)) {
		const networkType = capabilities.getNetworkCapabilities()
		if (networkType & android.net.NetworkCapabilities.NET_CAPABILITY_INTERNET) {
			// 判断网络类型
			const subType = capabilities.getLinkDownstreamBandwidthKbps()
			if (subType >= 10000) {
				type = '4g'
			} else if (subType >= 1000) {
				type = '3g'
			} else {
				type = '2g'
			}
		}
	}
	
	return {
		type,
		isConnected: true
	}
}

/**
 * 获取电池信息 - Android实现
 */
export function getBatteryInfo(): BatteryInfo {
	const context = android.content.Context
	const intent = context.registerReceiver(
		null,
		new android.content.IntentFilter(android.content.Intent.ACTION_BATTERY_CHANGED)
	)
	
	const level = intent.getIntExtra(android.os.BatteryManager.EXTRA_LEVEL, -1)
	const scale = intent.getIntExtra(android.os.BatteryManager.EXTRA_SCALE, -1)
	const status = intent.getIntExtra(android.os.BatteryManager.EXTRA_STATUS, -1)
	
	return {
		level: scale > 0 ? Math.round((level / scale) * 100) : 0,
		isCharging: status == android.os.BatteryManager.BATTERY_STATUS_CHARGING ||
					status == android.os.BatteryManager.BATTERY_STATUS_FULL
	}
}